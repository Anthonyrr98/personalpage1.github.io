<section id="life-archive" class="life-archive" aria-labelledby="life-archive-title">
  <div class="life-archive-intro">
    <div>
      <p class="life-archive-kicker">THE ARCHIVE</p>
      <h2 id="life-archive-title">往年生活记录</h2>
      <p>按年份和月份找回 {{ lifeArchive.years[lifeArchive.years.length - 1].year }}—{{ lifeArchive.years[0].year }} 年的 {{ lifeArchive.count }} 条记录。</p>
    </div>
  </div>
  <div class="life-archive-years">
    {% for year in lifeArchive.years %}
    <details class="life-archive-year">
      <summary><span>{{ year.year }} 年</span><span>{{ year.count }} 条记录 <span aria-hidden="true">⌄</span></span></summary>
      <div class="life-archive-months">
        {% for month in year.months %}
        <section class="life-archive-month" aria-label="{{ year.year }} 年 {{ month.month }} 月">
          <h3>{{ month.month }} 月</h3>
          <ul>
            {% for record in month.entries %}
            <li><span>{{ record.date }}</span><a href="{{ record.url }}">{{ record.title | escape }}</a></li>
            {% endfor %}
          </ul>
        </section>
        {% endfor %}
      </div>
    </details>
    {% endfor %}
  </div>
</section>
